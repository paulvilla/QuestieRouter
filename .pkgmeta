package-as: QuestieRouter

# Cuatro carpetas de addon en la raiz del repo -> el paquete las saca al nivel superior del zip
move-folders:
    QuestieRouter/QuestieRouter: QuestieRouter
    QuestieRouter/QuestieRouter_Nav: QuestieRouter_Nav
    QuestieRouter/QuestieRouter_Nav_EK: QuestieRouter_Nav_EK
    QuestieRouter/QuestieRouter_Nav_Kalimdor: QuestieRouter_Nav_Kalimdor

# Todo lo que no es el addon no entra en el zip
ignore:
    - QuestieRouter_0.9.1-beta.zip
    - QuestieRouter_0.9.2-beta.zip
    - QuestieRouter_1.0-beta.zip
    - QuestieRouter_1.1-beta.zip
    - QuestieRouter_1.2-beta.zip
    - QuestieRouter_1.3-beta.zip
    - QuestieRouter_1.5-beta.zip
    - QuestieRouter_1.6-beta.zip
    - QuestieRouter_1.8-beta.zip
    - QuestieRouter-128.png
    - Questi_addons
    - addons_ejemplo
    - backups
    - icons
    - imagenes
    - logos
    - mapas_generacion_rutas
    - otras_guias
    - presentacion
    - tools
    - wow.export
    - wow.tools
